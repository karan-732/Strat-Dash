# Turso / libSQL
TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=

# OpenRouter — the sprint runs on Claude, the router is how we reach it
OPENROUTER_API_KEY=
MODEL=anthropic/claude-sonnet-5
MODEL_FAST=anthropic/claude-haiku-4.5

# Optional direct OpenAI Responses API provider. Requests use it only when
# provider=openai is selected explicitly; OpenRouter stays the default.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low

# Live page reads for company and peer research
SCRAPE_READER_BASE=https://r.jina.ai/
